# Copy this file to .env. Replace the secrets on your own machine.
BETTER_AUTH_SECRET=replace-with-32-chars-minimum-local-secret
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=file:.data/app.db
ENCRYPTION_KEY=replace-with-a-long-random-local-key

# openai, anthropic or gemini. Anthropic and Gemini write text only.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-3.8-flash

# openai or none
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional, alongside SMTP in the app. Expects a JSON body such as Resend.
MAIL_API_URL=
MAIL_API_KEY=
OUTREACH_DAILY_LIMIT=50
