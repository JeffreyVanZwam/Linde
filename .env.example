# Copy this file to .env. Replace the secrets on your own machine.
APP_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-a-long-random-local-key

# PocketBase runs next to Nuxt. pnpm dev starts both.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@linde.local
POCKETBASE_ADMIN_PASSWORD=linde-local-admin

# free (default, no key), openai, anthropic or gemini.
# Anthropic and Gemini write text only. The free model is OpenAI-compatible.
AI_PROVIDER=free
FREE_BASE_URL=https://text.pollinations.ai/v1
FREE_MODEL=openai-fast
FREE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-3.8-flash

# openai or none
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Unreviewed TikTok apps can often post only to yourself.
TIKTOK_PRIVACY=SELF_ONLY

# Optional, alongside SMTP in the app. Expects a JSON body such as Resend.
MAIL_API_URL=
MAIL_API_KEY=
OUTREACH_DAILY_LIMIT=50
